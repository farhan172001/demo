public abstract class AesMskKafkaTopicConsumer<T>
        implements AesTopicConsumerInterface<T>, MigrateToAesTopicInterface<T> {

    @Autowired
    private AesSchemaValidationServiceFactory aecSchemaValidationServiceFactory;

    @Autowired
    private AesConsumerRetryStrategyFactory retryStrategyFactory;

    @Autowired
    private RuntimeInfo runtimeInfo;

    protected AesConsumerRetryStrategy retryStrategy;
    protected String topicName;

    private Class<T> type;
    private TypeReference<GeneralResponse<T>> typeRef;

    protected boolean shouldValidateConsumedMessagesAfterDeserialization;

    protected AesMskKafkaTopicConsumer(String topicName) {
        this(topicName, true);
    }

    protected AesMskKafkaTopicConsumer(
            String topicName,
            boolean shouldValidateConsumedMessagesAfterDeserialization) {

        this.topicName = topicName;
        this.shouldValidateConsumedMessagesAfterDeserialization =
                shouldValidateConsumedMessagesAfterDeserialization;
        this.setClassOfType();
    }

    @PostConstruct
    public void init() {
        this.setRetryStrategy(this.topicName);
    }

    /**
     * MAIN ORCHESTRATOR
     */
    protected void orchestrateEventProcess(Message<String> message) {

        try {
            if (retryStrategy.shouldDefer(message)) {
                defer(message);
                return;
            }

            // 1️⃣ Payload unwrap
            T payload = unwrapToType(message);

            // 2️⃣ Resolve correlation-id (header → payload → UUID)
            String correlationId = resolveCorrelationId(message, payload);

            // 3️⃣ Prepare headers
            Map<String, Object> headers = new HashMap<>(message.getHeaders());
            headers.put("correlation-id", correlationId);
            headers.put("context.runtime.info", runtimeInfo);

            MessageHeaders newHeaders = new MessageHeaders(headers);

            // 4️⃣ Set ThreadLocal Context
            CustomApplicationContext context = new CustomApplicationContext();
            context.setContext(newHeaders);
            ThreadLocalHolder.set(context);

            // 5️⃣ Call business logic
            processMessage(payload);

        } catch (Exception e) {
            if (retryStrategy.shouldRetry(message, e)) {
                backOff(message, e);
            } else {
                fail(message, new AesEventualFailureResult(e));
            }
        }
    }

    /**
     * Resolve correlation-id from:
     * Header → Payload → UUID
     */
    private String resolveCorrelationId(Message<String> message, T payload) {

        Object headerValue = message.getHeaders().get("correlation-id");
        if (headerValue instanceof byte[]) {
            return new String((byte[]) headerValue, StandardCharsets.UTF_8);
        }

        String payloadCorrelationId = getCorrelationIdFromPayload(payload);
        if (payloadCorrelationId != null && !payloadCorrelationId.isEmpty()) {
            return payloadCorrelationId;
        }

        return UUID.randomUUID().toString();
    }

    /**
     * Payload-based correlation-id hook.
     * Consumer can override.
     */
    protected String getCorrelationIdFromPayload(T payload) {
        return null;
    }

    protected void defer(Message<String> message) {
        throw new UnsupportedOperationException();
    }

    protected void backOff(Message<String> message, Exception e) {
        try {
            retryStrategy.backOff(message, e);
        } catch (AESTopicSendException ex) {
            retryStrategy.fallback(prepareGenericMessageForSerialization(message));
        }
    }

    protected void fail(Message<String> message, AesEventualFailureResult e) {
        try {
            retryStrategy.fail(message, e);
            retryStrategy.sendFailEmail(message, e);
        } catch (AESTopicSendException ex) {
            retryStrategy.fallback(prepareGenericMessageForSerialization(message));
            retryStrategy.sendFallbackEmail(message, e);
        }
    }

    private AesKafkaMessage prepareGenericMessageForSerialization(Message<String> message) {
        try {
            Map<String, String> headerMap =
                    message.getHeaders().entrySet().stream()
                            .collect(Collectors.toMap(
                                    Map.Entry::getKey,
                                    e -> String.valueOf(e.getValue())
                            ));

            return AesKafkaMessage.builder()
                    .kafkaHeaders(headerMap)
                    .generalResponse(unwrapToGeneralResponse(message))
                    .build();

        } catch (ApplicationException e) {
            AesKafkaAppLogger.error(
                    this.getClass(),
                    "Failed to convert message. Headers: [{}], Payload: [{}]",
                    message.getHeaders(),
                    message.getPayload()
            );
            throw new RuntimeException(e);
        }
    }

    protected T unwrapToType(Message<String> message) throws ApplicationException {
        try {
            ObjectMapper mapper = new ObjectMapper();
            GeneralResponse<T> gr =
                    mapper.readValue(message.getPayload(), typeRef);
            return gr.getData();
        } catch (JsonProcessingException e) {
            Optional<T> legacy = unwrapToTypeFromLegacy(message);
            if (legacy.isPresent()) {
                return legacy.get();
            }
            throw new ApplicationException(
                    "Unwrapping to generic type failed",
                    e,
                    ExceptionType.TECHNICAL
            );
        }
    }

    private GeneralResponse<T> unwrapToGeneralResponse(Message<String> message)
            throws ApplicationException {

        try {
            ObjectMapper mapper = new ObjectMapper();
            return mapper.readValue(message.getPayload(), typeRef);
        } catch (JsonProcessingException e) {
            throw new ApplicationException(
                    "Unwrapping to GeneralResponse failed",
                    e,
                    ExceptionType.TECHNICAL
            );
        }
    }

    protected AesMessageValidationResult validate(Message<String> message)
            throws ApplicationException {

        return aecSchemaValidationServiceFactory.validate(
                topicName,
                unwrapToGeneralResponse(message)
        );
    }

    private void setClassOfType() {
        Type superType = getClass().getGenericSuperclass();

        while (superType != Object.class) {
            if (superType instanceof ParameterizedType pt) {
                Type arg = pt.getActualTypeArguments()[0];
                if (arg instanceof Class<?>) {
                    this.type = (Class<T>) arg;
                    break;
                }
                superType =
                        ((Class<?>) pt.getRawType()).getGenericSuperclass();
            } else if (superType instanceof Class<?>) {
                superType = ((Class<?>) superType).getGenericSuperclass();
            }
        }

        if (type == null) {
            throw new IllegalArgumentException(
                    "Unable to determine generic type"
            );
        }

        this.typeRef = new TypeReference<>() {
            @Override
            public Type getType() {
                return TypeFactory.defaultInstance()
                        .constructParametricType(
                                GeneralResponse.class,
                                type
                        );
            }
        };
    }

    public void setRetryStrategy(String topicName) {
        if (retryStrategy == null) {
            retryStrategy =
                    retryStrategyFactory.getAesConsumerRetryStrategy(topicName);
        }
    }

    protected String epochToStringUTC(Long epochMillis) {
        LocalDateTime time =
                Instant.ofEpochMilli(epochMillis)
                        .atZone(ZoneId.of("UTC"))
                        .toLocalDateTime();
        return time.format(
                DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));
    }

    protected String buildGroupIdSuffix(String awsAccountId, String homeDirectory) {

        if (awsAccountId != null && !awsAccountId.isEmpty()
                && !awsAccountId.equals("unknownAccountId")) {
            return "-" + awsAccountId;
        }

        if (homeDirectory != null && !homeDirectory.isEmpty()
                && !homeDirectory.equals("unknownHomeDirectory")) {
            return "-" + homeDirectory
                    .replace("/", "-")
                    .replace("\\", "-")
                    .replace(":", "-");
        }

        return "";
    }

    public String getTopicName() {
        return topicName;
    }

    public Class<T> getType() {
        return type;
    }

    public TypeReference<GeneralResponse<T>> getTypeRef() {
        return typeRef;
    }
}

















private String extractLegacyCorrelationIdFromPayload(String payload) {
    try {
        ObjectMapper mapper = new ObjectMapper();
        JsonNode root = mapper.readTree(payload);

        JsonNode kafkaHeaders = root.get("kafka-headers");
        if (kafkaHeaders != null) {
            JsonNode corrNode = kafkaHeaders.get("aflac-correlation-id");
            if (corrNode != null && !corrNode.isNull()) {
                String id = corrNode.asText();
                if (!id.isBlank()) {
                    return id;
                }
            }
        }
    } catch (Exception ignored) {
        // must NOT break processing
    }
    return null;
}











protected void orchestrateEventProcess(Message<String> message) {

    try {

        // 🔹 Existing retry behavior (UNCHANGED)
        if (this.retryStrategy.shouldDefer(message)) {
            this.defer(message);
            return;
        }

        // =====================================================
        // ✅ UPDATED CORRELATION-ID LOGIC (NEW + LEGACY SAFE)
        // =====================================================

        String correlationId = null;

        // 1️⃣ Existing behavior: read from Kafka header (UNCHANGED)
        Object headerValue = message.getHeaders().get("correlation-id");
        if (headerValue instanceof byte[]) {
            correlationId = new String((byte[]) headerValue, StandardCharsets.UTF_8);
        }

        // 2️⃣ NEW: legacy support – read from payload JSON if header missing
        if (correlationId == null || correlationId.isBlank()) {
            correlationId = extractLegacyCorrelationIdFromPayload(message.getPayload());
        }

        // 3️⃣ Safety fallback (optional but recommended)
        if (correlationId == null || correlationId.isBlank()) {
            correlationId = UUID.randomUUID().toString();
        }

        // =====================================================
        // 🔹 Context setup (UNCHANGED)
        // =====================================================

        Map<String, Object> newHeadersMap = new HashMap<>(message.getHeaders());
        newHeadersMap.put("context.runtime.info", this.runtimeInfo);
        newHeadersMap.put("correlation-id", correlationId);

        MessageHeaders newHeaders = new MessageHeaders(newHeadersMap);

        CustomApplicationContext customApplicationContext = new CustomApplicationContext();
        customApplicationContext.setContext(newHeaders);
        ThreadLocalHolder.set(customApplicationContext);

        // 🔹 Existing behavior: unwrap + process
        this.processMessage(this.unwrapToType(message));

    } catch (Exception e) {

        if (this.retryStrategy.shouldRetry(message, e)) {
            this.backOff(message, e);
        } else {
            this.fail(message, new AesEventualFailureResult(e));
        }
    }
}
